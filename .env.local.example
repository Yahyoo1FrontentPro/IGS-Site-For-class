# ============================================================================
# MYP 3 Activity Hub — Environment Variables Template
# Copy this file to `.env.local` and fill in your Supabase values.
# ============================================================================

# 1. Supabase Project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Public Anon Key (Project Settings -> API -> Project API keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Supabase Service Role Key (Project Settings -> API -> Project API keys -> service_role secret)
# NEVER prefix with NEXT_PUBLIC_ — used strictly on the server in API routes
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. Session Cookie Signing Secret (any random 32+ character string)
SESSION_SECRET=replace-with-a-random-32-character-secret
